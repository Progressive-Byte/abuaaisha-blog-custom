# Copy to .env.local and fill in. Never commit real values.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://abuaaisha.com

# --- MongoDB (Atlas M0) -----------------------------------------------------
MONGODB_URI=

# --- Admin session ----------------------------------------------------------
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
ADMIN_EMAIL=you@example.com
# Generate with: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=

# Shared secret used by the API to ask the Next.js app to refresh cached pages.
REVALIDATE_SECRET=

# --- Cloudinary -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI drafting ------------------------------------------------------------
# gemini (default) or openai (any OpenAI-compatible endpoint)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
# Optional base URL override (proxy / compatible provider)
AI_BASE_URL=
# Drafts per admin per 24h
AI_DAILY_LIMIT=10

# --- Contact email (optional) ----------------------------------------------
# Without a key, messages are still stored in MongoDB.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
