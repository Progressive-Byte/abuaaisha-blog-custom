    "dotenv": "^17.0.0",
    "express": "^5.3.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.15",
    "mongoose": "^9.11.4",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
