---
import Icon from "./Icon.astro";
import { toBanglaDigits } from "../lib/format";

interface Props {
  current: number;
  total: number;
  /** Base path of page 1, e.g. "/posts/"; page n is `${base}page/n/`. */
  base: string;
}

const { current, total, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}page/${n}/`);

// 1 … (current-1) current (current+1) … total
const pages: (number | "gap")[] = [];
for (let n = 1; n <= total; n++) {
  if (n === 1 || n === total || Math.abs(n - current) <= 1) pages.push(n);
  else if (pages.at(-1) !== "gap") pages.push("gap");
}
---

{
  total > 1 && (
    <nav class="pagination" aria-label="পাতা নির্বাচন">
      {current > 1 ? (
        <a class="btn btn--outline step" href={href(current - 1)} rel="prev">
          <Icon name="arrow-right" class="flip" />
          আগের পাতা
        </a>
      ) : (
        <span class="btn btn--outline step is-disabled" aria-hidden="true">আগের পাতা</span>
      )}
      <ol>
        {pages.map((p) =>
          p === "gap" ? (
            <li class="gap" aria-hidden="true">…</li>
          ) : (
            <li>
              <a class:list={["num", { active: p === current }]} href={href(p)} aria-current={p === current ? "page" : undefined}>
                <span class="visually-hidden">পাতা </span>
                {toBanglaDigits(p)}
              </a>
            </li>
          ),
        )}
      </ol>
      {current < total ? (
        <a class="btn btn--outline step" href={href(current + 1)} rel="next">
          পরের পাতা
          <Icon name="arrow-right" />
        </a>
      ) : (
        <span class="btn btn--outline step is-disabled" aria-hidden="true">পরের পাতা</span>
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
  }

  ol {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .num {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1.5px solid var(--color-line-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-ink-900);
    font-size: var(--text-ui);
    font-weight: 600;
    text-decoration: none;
  }

  .num.active {
    border-color: var(--color-btn);
    background: var(--color-btn);
    color: var(--color-on-dark);
  }

  .gap {
    display: grid;
    place-items: center;
    width: 2rem;
    color: var(--color-ink-500);
  }

  .step :global(.flip) {
    transform: scaleX(-1);
  }

  .is-disabled {
    color: var(--color-line-strong);
    pointer-events: none;
  }
</style>
