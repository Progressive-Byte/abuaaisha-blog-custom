---
// AI drafting page. Not linked anywhere, noindex, and left out of the sitemap.
// The page holds no secrets: it only gets the editor's GitHub token (Netlify OAuth)
// and sends it to the functions, which verify it and hold the AI and bot keys.
import Icon from "../../components/Icon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CATEGORIES } from "../../lib/post-schema";
import { CATEGORY_META } from "../../lib/site";
---

<BaseLayout title="AI খসড়া" noindex>
  <section class="container ai">
    <header>
      <span class="overline">অ্যাডমিন</span>
      <h1>AI দিয়ে খসড়া তৈরি</h1>
      <p>
        বিষয় দিন—AI একটি খসড়া (শিরোনাম, সারাংশ, লেখা, কভার ছবি ও তথ্যসূত্র) তৈরি করে <strong>খসড়া হিসেবে</strong> সংরক্ষণ
        করবে। প্রকাশের আগে পুরো লেখা পড়ুন এবং প্রতিটি তথ্যসূত্র খুলে যাচাই করুন।
      </p>
    </header>

    <div class="card" data-signin>
      <p>শুরু করতে GitHub দিয়ে লগইন করুন। (CMS-এ লগইন করা থাকলে সেটিই ব্যবহার হবে।)</p>
      <button class="btn btn--primary" type="button" data-login>GitHub দিয়ে লগইন</button>
      <p class="error" data-login-error hidden></p>
    </div>

    <form class="card form" data-form hidden>
      <div class="field">
        <label for="topic">বিষয়</label>
        <textarea id="topic" name="topic" rows="3" required minlength="5" maxlength="500" placeholder="যেমন: কিশোর সন্তানের সাথে মোবাইল ব্যবহার নিয়ে আলোচনা কীভাবে শুরু করবেন"></textarea>
      </div>

      <div class="row">
        <div class="field">
          <label for="category">বিভাগ</label>
          <select id="category" name="category">
            {CATEGORIES.map((c) => <option value={c} selected={c === "social"}>{CATEGORY_META[c].label}</option>)}
          </select>
        </div>
        <fieldset class="field">
          <legend>দৈর্ঘ্য</legend>
          <div class="lengths">
            <label><input type="radio" name="length" value="short" /> ছোট (~৭০০ শব্দ)</label>
            <label><input type="radio" name="length" value="medium" checked /> মাঝারি (~১২০০)</label>
            <label><input type="radio" name="length" value="long" /> বড় (~২০০০)</label>
          </div>
        </fieldset>
      </div>

      <div class="field">
        <label for="notes">বাড়তি নির্দেশনা (ঐচ্ছিক)</label>
        <textarea id="notes" name="notes" rows="3" maxlength="2000" placeholder="যেমন: একটি ব্যক্তিগত ঘটনা দিয়ে শুরু করুন; শেষে পরিবারের জন্য ৫টি করণীয়"></textarea>
      </div>

      <button class="btn btn--primary" type="submit" data-generate>
        <Icon name="pen" /> খসড়া তৈরি করুন
      </button>
      <p class="who" data-who></p>
    </form>

    <div class="card status" data-status hidden aria-live="polite">
      <p class="state" data-state></p>
      <p class="detail" data-detail></p>
      <a class="btn btn--primary" data-edit hidden>Sveltia-তে খসড়াটি খুলুন <Icon name="arrow-right" /></a>
    </div>
  </section>
</BaseLayout>

<script>
  type Status = { status: "running" | "ready" | "failed" | "unknown"; slug: string; error?: string; editUrl?: string };

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const signin = $("[data-signin]");
  const form = $<HTMLFormElement>("[data-form]");
  const generate = $<HTMLButtonElement>("[data-generate]");
  const statusBox = $("[data-status]");
  const stateEl = $("[data-state]");
  const detailEl = $("[data-detail]");
  const editLink = $<HTMLAnchorElement>("[data-edit]");
  const loginError = $("[data-login-error]");

  const TOKEN_KEY = "ai-github-token";
  const JOB_KEY = "ai-current-job";

  // ---- Token: reuse Sveltia CMS's login, else Netlify's GitHub OAuth popup ----
  function storedToken(): string | null {
    try {
      const own = sessionStorage.getItem(TOKEN_KEY);
      if (own) return own;
      const cms = JSON.parse(localStorage.getItem("sveltia-cms.user") ?? "null");
      return cms?.token ?? null;
    } catch {
      return null;
    }
  }

  function netlifyLogin(): Promise<string> {
    // Netlify identifies the site by its domain; on localhost pass ?site=<your>.netlify.app
    const site = new URLSearchParams(location.search).get("site") ?? location.hostname;
    const url = `https://api.netlify.com/auth?provider=github&site_id=${encodeURIComponent(site)}&scope=read:user`;
    const popup = window.open(url, "netlify-auth", "width=960,height=640");
    return new Promise((resolve, reject) => {
      if (!popup) return reject(new Error("পপআপ ব্লক হয়েছে—ব্রাউজারে পপআপের অনুমতি দিন।"));
      const onMessage = (e: MessageEvent) => {
        if (e.origin !== "https://api.netlify.com" || typeof e.data !== "string") return;
        if (e.data === "authorizing:github") {
          popup.postMessage(e.data, e.origin); // handshake
          return;
        }
        const m = e.data.match(/^authorization:github:(success|error):(.*)$/s);
        if (!m) return;
        window.removeEventListener("message", onMessage);
        popup.close();
        const payload = JSON.parse(m[2]);
        if (m[1] === "success" && payload.token) resolve(payload.token);
        else reject(new Error(payload.message ?? "লগইন ব্যর্থ হয়েছে"));
      };
      window.addEventListener("message", onMessage);
    });
  }

  async function api(path: string, init: RequestInit = {}) {
    const token = storedToken();
    const res = await fetch(`/.netlify/functions/${path}`, {
      ...init,
      headers: { ...init.headers, authorization: `Bearer ${token}`, "content-type": "application/json" },
    });
    const body = await res.json().catch(() => ({}));
    if (res.status === 401) {
      sessionStorage.removeItem(TOKEN_KEY);
      showSignin();
    }
    if (!res.ok && res.status !== 404) throw new Error(body.error ?? `ত্রুটি (${res.status})`);
    return body;
  }

  function showSignin() {
    signin.hidden = false;
    form.hidden = true;
  }

  function showForm() {
    signin.hidden = true;
    form.hidden = false;
  }

  $("[data-login]").addEventListener("click", async () => {
    loginError.hidden = true;
    try {
      sessionStorage.setItem(TOKEN_KEY, await netlifyLogin());
      showForm();
    } catch (err) {
      loginError.textContent = (err as Error).message;
      loginError.hidden = false;
    }
  });

  // ---- Job flow ----
  function render(s: Partial<Status> & { status: string }, extra = "") {
    statusBox.hidden = false;
    statusBox.dataset.state = s.status;
    editLink.hidden = true;
    if (s.status === "running") {
      stateEl.textContent = `খসড়া তৈরি হচ্ছে… (${s.slug})`;
      detailEl.textContent = extra || "AI লিখছে ও ছবি তৈরি করছে। সাধারণত ১–৩ মিনিট লাগে। এই পাতা খোলা রাখুন।";
    } else if (s.status === "ready") {
      stateEl.textContent = `খসড়া প্রস্তুত: ${s.slug}`;
      detailEl.textContent = "লেখাটি draft: true অবস্থায় আছে। পড়ুন, তথ্যসূত্র যাচাই করুন, তারপর প্রকাশ করুন।";
      editLink.href = s.editUrl ?? "/admin/";
      editLink.hidden = false;
    } else {
      stateEl.textContent = `খসড়া তৈরি হয়নি (${s.slug ?? ""})`;
      detailEl.textContent = s.error ?? "অজানা ত্রুটি";
    }
  }

  async function poll(slug: string) {
    generate.disabled = true;
    render({ status: "running", slug });
    for (;;) {
      await new Promise((r) => setTimeout(r, 5000));
      try {
        const s: Status = await api(`ai-status?slug=${slug}`);
        if (s.status === "running" || s.status === "unknown") continue;
        render(s);
        break;
      } catch (err) {
        render({ status: "running", slug }, `অবস্থা জানা যাচ্ছে না: ${(err as Error).message}। আবার চেষ্টা করছি…`);
      }
    }
    sessionStorage.removeItem(JOB_KEY);
    generate.disabled = false;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (generate.disabled) return; // one generation per click
    generate.disabled = true;
    const data = Object.fromEntries(new FormData(form));
    try {
      const { slug } = await api("ai-generate", { method: "POST", body: JSON.stringify(data) });
      sessionStorage.setItem(JOB_KEY, slug);
      await poll(slug);
    } catch (err) {
      render({ status: "failed" }, "");
      detailEl.textContent = (err as Error).message;
      generate.disabled = false;
    }
  });

  // ---- Start ----
  if (storedToken()) showForm();
  else showSignin();
  const running = sessionStorage.getItem(JOB_KEY);
  if (running) poll(running);
</script>

<style>
  .ai {
    display: grid;
    gap: var(--space-6);
    max-width: calc(48rem + 2 * var(--gutter));
    padding-block: var(--space-8) var(--space-9);
  }

  header {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  h1 {
    font-size: var(--text-h1);
  }

  header p {
    color: var(--color-ink-500);
  }

  .card {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .card[hidden] {
    display: none;
  }

  .card > .btn {
    justify-self: start;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-5);
  }

  .field {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
  }

  label,
  legend {
    color: var(--color-ink-900);
    font-weight: 600;
  }

  .lengths label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 400;
  }

  textarea,
  select {
    width: 100%;
    padding: 0.75rem var(--space-4);
    border: 1.5px solid var(--color-line-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    font-size: var(--text-small);
  }

  textarea:focus,
  select:focus {
    border-color: var(--color-accent-700);
    outline: none;
  }

  button[disabled] {
    opacity: 0.55;
    cursor: progress;
  }

  .who,
  .detail {
    color: var(--color-ink-500);
    font-size: var(--text-meta);
  }

  .state {
    color: var(--color-ink-900);
    font-size: var(--text-h5);
    font-weight: 600;
  }

  .status[data-state="failed"] {
    border-color: var(--color-danger);
  }

  .error {
    color: var(--color-danger);
  }
</style>
