---
import { getEntry, render } from "astro:content";
import ArchFrame from "../components/ArchFrame.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES } from "../lib/post-schema";
import { CATEGORY_META, SITE } from "../lib/site";

const page = await getEntry("pages", "about");
if (!page) throw new Error("src/content/pages/about.md is missing");
const { Content } = await render(page);

const highlights = [
  { icon: "history", text: "নব্বইয়ের দশকে বেড়ে ওঠা" },
  { icon: "book", text: "সালাফদের পথ অনুসরণের চেষ্টা" },
  { icon: "pen", text: "মুসলিমদের চ্যালেঞ্জ ও সমাধান নিয়ে লেখা" },
];

const topicImages = {
  faith: { src: "/images/site/topic-faith.webp", alt: "মসজিদে কাতারবন্দি হয়ে সালাত আদায় করছেন মুসল্লিরা" },
  social: { src: "/images/site/topic-social.webp", alt: "ঘরে বসে আলাপ করছেন দুইজন নারী" },
  worldview: { src: "/images/site/topic-worldview.webp", alt: "সন্ধ্যার আকাশের নিচে শহরের দৃশ্য, দূরে মিনার" },
};
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="hero lattice-band" aria-labelledby="about-title">
    <div class="container hero-grid">
      <div class="intro">
        <span class="overline overline--glass"><span class="gold-dot"></span>পরিচিতি</span>
        <h1 id="about-title">{SITE.name}</h1>
        <p class="role">লেখক ও ইসলামিক কাউন্সেলর</p>
        <p class="lede">{page.data.description}</p>
        <div class="actions">
          <a class="btn btn--light" href="/counseling/#sessions">সেশন বুক করুন <Icon name="arrow-right" /></a>
          <a class="btn btn--ghost-light" href="/posts/">লেখাগুলো পড়ুন</a>
        </div>
      </div>
      <ArchFrame src="/images/site/about-arch.webp" alt="সন্ধ্যার আলোয় পুরোনো বাড়ির সামনে মাঠে ফুটবল খেলছে শিশুরা" />
    </div>
  </section>

  <section class="section" aria-labelledby="story-title">
    <div class="container story">
      <div class="story-head">
        <span class="overline">আমার গল্প</span>
        <h2 id="story-title">সালাফদের পথ, নব্বইয়ের স্মৃতি আর আজকের প্রশ্ন</h2>
        <div class="ornament" aria-hidden="true"><span></span><Icon name="star" size={12} /><span></span></div>
        <ul>
          {
            highlights.map((h) => (
              <li>
                <span class="hl-icon"><Icon name={h.icon} size={18} /></span>
                {h.text}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="story-body">
        <Content />
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="topics-title">
    <div class="container">
      <div class="section-head">
        <h2 id="topics-title">যে বিষয়গুলো নিয়ে লিখি</h2>
        <a class="btn btn--outline" href="/posts/">সব লেখা দেখুন <Icon name="arrow-right" /></a>
      </div>
      <div class="topics">
        {
          CATEGORIES.map((c) => (
            <a class="topic" href={`/categories/${c}/`}>
              <img src={topicImages[c].src} alt={topicImages[c].alt} width="1264" height="848" loading="lazy" decoding="async" />
              <span class="topic-body">
                <span class="topic-icon">
                  <Icon name={CATEGORY_META[c].icon} size={20} />
                </span>
                <strong>{CATEGORY_META[c].label}</strong>
                <span>{CATEGORY_META[c].blurb}</span>
                <span class="topic-link">
                  লেখাগুলো দেখুন <Icon name="arrow-right" />
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-label="পরবর্তী পদক্ষেপ">
    <div class="container ctas">
      <div class="cta cta--light">
        <Icon name="pen" size={20} class="cta-icon" />
        <h2>লেখাগুলো পড়ুন</h2>
        <p>দ্বীন, পরিবার আর সমকালীন সমাজ নিয়ে সব লেখা এক জায়গায়।</p>
        <a class="btn btn--primary" href="/posts/">ব্লগ দেখুন <Icon name="arrow-right" /></a>
      </div>
      <div class="cta cta--dark">
        <Icon name="chat" size={20} class="cta-icon" />
        <h2>পরামর্শ প্রয়োজন?</h2>
        <p>পারিবারিক বা ব্যক্তিগত বিষয়ে একান্তে কথা বলতে সেশন বুক করুন।</p>
        <a class="btn btn--light" href="/counseling/#sessions">সেশন বুক করুন <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 31.75rem);
    align-items: center;
    gap: var(--space-7) 2.5rem;
  }

  .intro {
    display: grid;
    justify-items: start;
    max-width: 38rem;
  }

  .gold-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-gold-500);
  }

  h1 {
    margin-top: var(--space-6);
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 1.24;
  }

  .role {
    margin-top: var(--space-3);
    color: var(--color-gold-500);
    font-size: var(--text-h4);
    font-weight: 600;
  }

  .lede {
    margin-top: var(--space-4);
    color: var(--color-on-dark);
    font-size: var(--text-body-lg);
    line-height: 1.7;
    opacity: 0.9;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (max-width: 60rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-grid :global(.arch) {
      justify-self: center;
      width: min(100%, 22rem);
      order: -1;
    }
  }

  /* ---------- Story ---------- */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
    gap: var(--space-7) 6rem;
  }

  .story-head {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-4);
  }

  .story-head h2 {
    font-size: var(--text-h2);
    letter-spacing: -0.02em;
  }

  .ornament {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-gold-500);
  }

  .ornament span {
    width: 2rem;
    height: 2px;
    background: var(--color-gold-500);
  }

  .story-head ul {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .story-head li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-ink-700);
    font-size: var(--text-body);
  }

  .hl-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--color-accent-50);
    color: var(--color-accent-700);
  }

  .story-body {
    display: grid;
    gap: var(--space-5);
    font-size: var(--text-body);
    line-height: 1.8;
  }

  .story-body :global(blockquote) {
    margin: var(--space-2) 0;
    padding: var(--space-6) var(--space-6);
    border-left: 3px solid var(--color-accent-700);
    border-radius: var(--radius-md);
    background: var(--color-paper-deep);
    color: var(--color-ink-900);
    font-size: var(--text-body-lg);
    font-weight: 600;
    line-height: 1.6;
  }

  @media (max-width: 60rem) {
    .story {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Topics ---------- */
  .topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
  }

  .topic {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 390 / 360;
    border-radius: var(--radius-lg);
    color: var(--color-on-dark);
    text-decoration: none;
  }

  .topic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  @media (prefers-reduced-motion: no-preference) {
    .topic:hover img {
      transform: scale(1.04);
    }
  }

  .topic::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(10 23 48 / 0.05) 20%, rgb(10 23 48 / 0.9) 100%);
  }

  .topic-body {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-6);
  }

  .topic-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-3);
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
  }

  .topic strong {
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.4;
  }

  .topic-body > span:not(.topic-icon, .topic-link) {
    color: var(--color-on-dark-muted);
    font-size: var(--text-small);
  }

  .topic-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-ui);
    font-weight: 600;
  }

  /* ---------- Two CTAs ---------- */
  .ctas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-5);
  }

  .cta {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: clamp(1.75rem, 1rem + 2vw, 3rem);
    border-radius: var(--radius-xl);
  }

  .cta h2 {
    font-size: var(--text-h3);
  }

  .cta p {
    font-size: var(--text-body-lg);
    line-height: 1.7;
  }

  .cta--light {
    background: var(--color-paper-deep);
  }

  .cta--dark {
    background: var(--color-band);
    color: var(--color-on-dark-muted);
  }

  .cta--dark h2 {
    color: var(--color-on-dark);
  }

  .cta :global(.cta-icon) {
    color: var(--color-gold-500);
  }
</style>
